{
  "schemaVersion": 1,
  "id": "anuj-omarchy-ai-usage-tracker",
  "name": "Anuj Omarchy AI Usage Tracker",
  "version": "0.1.0",
  "author": "Rob Zolkos",
  "license": "MIT",
  "description": "Tabbed Claude, Codex, and Grok usage, limits, tokens by model, and API-equivalent estimates in one Omarchy bar icon.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "assets": ["claude.svg", "codex.svg"],
  "barWidget": {
    "displayName": "Anuj Omarchy AI Usage Tracker",
    "description": "One AI usage icon with Claude, Codex, and Grok tabs plus model token usage and estimates.",
    "category": "AI",
    "aliases": [
      "agent-usage",
      "claude-usage",
      "codex-usage",
      "anuj-ai-usage"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 300
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 60,
        "max": 3600,
        "step": 60,
        "defaultValue": 300
      }
    ]
  }
}
